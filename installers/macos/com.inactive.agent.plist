<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    macOS LaunchDaemon plist for Inactive Host Agent
    Install to: /Library/LaunchDaemons/com.inactive.agent.plist
    Load with: sudo launchctl load /Library/LaunchDaemons/com.inactive.agent.plist
-->
<plist version="1.0">
<dict>
    <!-- Unique identifier for this daemon -->
    <key>Label</key>
    <string>com.inactive.agent</string>

    <!-- Binary to run -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/inactive-agent</string>
        <string>--daemon</string>
    </array>

    <!-- Start at system boot, before any user login -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Auto-restart if it crashes -->
    <key>KeepAlive</key>
    <true/>

    <!-- Run as root (required for LaunchDaemon) -->
    <key>UserName</key>
    <string>root</string>

    <!-- Log stdout to file -->
    <key>StandardOutPath</key>
    <string>/var/log/inactive-agent.log</string>

    <!-- Log stderr to file -->
    <key>StandardErrorPath</key>
    <string>/var/log/inactive-agent-error.log</string>

    <!-- Environment variables -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>RUST_LOG</key>
        <string>host_agent=info</string>
    </dict>

    <!-- Throttle restart — wait 10s before restarting after crash -->
    <key>ThrottleInterval</key>
    <integer>10</integer>
</dict>
</plist>

