# Multi-stage Dockerfile for Remote Desk Signaling Server
FROM rust:1.80-slim-bullseye AS builder

WORKDIR /app
COPY Cargo.toml ./
COPY crates/signaling-server ./crates/signaling-server
COPY crates/core ./crates/core
COPY crates/host-agent ./crates/host-agent
COPY crates/client-app/src-tauri ./crates/client-app/src-tauri

RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
RUN cargo build --release --package signaling-server

# Runtime image
FROM debian:bullseye-slim

WORKDIR /app
RUN apt-get update && apt-get install -y ca-certificates openssl && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/signaling-server /app/signaling-server

EXPOSE 8080 443
ENV RUST_LOG=signaling_server=info
ENV LISTEN_ADDR=0.0.0.0:8080

CMD ["/app/signaling-server"]

